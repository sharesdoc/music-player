# 本地开发环境配置
# 用法: 复制为 env.loc 后填写真实值，再 source env.loc 或在 run 脚本中自动加载

# 应用
APP_ENV=local
APP_DEBUG=true
APP_PORT=2510
LOG_LEVEL=DEBUG

# 安全
JWT_SECRET=CHANGE_ME_LOCAL_DEV_SECRET

# 数据库（本地测试用，覆盖config.yml路径）
DATABASE_PATH=./data/music.db

# 音乐路径（本地开发时指向测试数据）
SYSTEM_MUSIC_PATH=/path/to/your/music
UPLOAD_PATH=./uploads

# AI（本地 Ollama — gemma4:12b）
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=gemma3:27b
AI_ENABLED=true

# 超级管理员（不存入数据库，直接通过 env 认证）
ADMIN_USERNAME=admin
# 填写密码的 SHA1 哈希（40位十六进制），生成: printf "%s" "你的密码" | shasum | cut -d" " -f1
ADMIN_PASSWORD=CHANGE_ME_SHA1_HASH
