#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# NEUROMIX // GRID — 一键安装脚本
# 在服务器上运行，完成：系统依赖 → 应用部署 → 配置生成 → 音乐导入 → 启动服务
#
# 用法:
#   # 本地打包:
#   ./run release
#   scp dist/neuromix-*.tar.gz user@server:/tmp/
#
#   # 服务器上安装:
#   cd /tmp && tar xzf neuromix-*.tar.gz && cd neuromix-*
#   sudo bash install.sh [选项]
#
# 选项:
#   --domain <域名>        设置域名（配置 Nginx server_name）
#   --port <端口>          监听端口（默认 2510）
#   --music <路径>         音乐库路径（默认 /var/www/html/downloads/mp3）
#   --admin-user <用户名>  超级管理员用户名（默认 admin）
#   --admin-pass <密码>    超级管理员密码（默认随机生成）
#   --skip-import          跳过音乐导入（仅部署应用）
#   --skip-nginx           跳过 Nginx 配置
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

# ── 参数 ──────────────────────────────────────────────────────
DOMAIN=""
APP_PORT="2510"
MUSIC_PATH="/var/www/html/downloads/mp3"
ADMIN_USER="admin"
ADMIN_PASS=""
SKIP_IMPORT=false
SKIP_NGINX=false
INSTALL_DIR="/opt/neuromix"
APP_USER="neuromix"
WORKERS=4

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

while [[ $# -gt 0 ]]; do
  case $1 in
    --domain)       DOMAIN="$2"; shift 2;;
    --port)         APP_PORT="$2"; shift 2;;
    --music)        MUSIC_PATH="$2"; shift 2;;
    --admin-user)   ADMIN_USER="$2"; shift 2;;
    --admin-pass)   ADMIN_PASS="$2"; shift 2;;
    --skip-import)  SKIP_IMPORT=true; shift;;
    --skip-nginx)   SKIP_NGINX=true; shift;;
    --dir)          INSTALL_DIR="$2"; shift 2;;
    --workers)      WORKERS="$2"; shift 2;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | grep '^#' | sed 's/^# \?//'
      exit 0;;
    *) shift;;
  esac
done

# ── 颜色 ──────────────────────────────────────────────────────
RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[1;33m')
CYAN=$(printf '\033[0;36m')
BOLD=$(printf '\033[1m')
NC=$(printf '\033[0m')
log_info()  { printf "%s[INFO]%s  %s\n"  "$GREEN"  "$NC" "$1"; }
log_warn()  { printf "%s[WARN]%s  %s\n"  "$YELLOW" "$NC" "$1"; }
log_error() { printf "%s[ERROR]%s %s\n"  "$RED"    "$NC" "$1" >&2; }
log_title() { printf "\n%s%s=== %s ===%s\n\n" "$CYAN" "$BOLD" "$1" "$NC"; }

# ── 权限检查 ──────────────────────────────────────────────────
if [ "$(id -u)" != "0" ]; then
  log_error "请使用 sudo 运行: sudo bash install.sh"
  exit 1
fi

# ── 检查源文件 ────────────────────────────────────────────────
if [ ! -f "$SCRIPT_DIR/app/main.py" ]; then
  log_error "未找到应用文件，请在解压后的目录中运行此脚本"
  exit 1
fi

# ── 生成密钥 ──────────────────────────────────────────────────
JWT_SECRET=$(python3 -c "import secrets; print(secrets.token_hex(64))" 2>/dev/null || openssl rand -hex 64)
if [ -z "$ADMIN_PASS" ]; then
  ADMIN_PASS=$(python3 -c "import secrets; print(secrets.token_urlsafe(12))" 2>/dev/null || openssl rand -base64 12)
fi
ADMIN_HASH=$(printf '%s' "$ADMIN_PASS" | sha1sum | awk '{print $1}' 2>/dev/null || printf '%s' "$ADMIN_PASS" | shasum -a 1 | awk '{print $1}')

printf "\n${BOLD}${CYAN}╔══════════════════════════════════════════════════╗${NC}\n"
printf "${BOLD}${CYAN}║  NEUROMIX // GRID  Installation                  ║${NC}\n"
printf "${BOLD}${CYAN}╚══════════════════════════════════════════════════╝${NC}\n\n"
printf "  安装目录:   ${YELLOW}${INSTALL_DIR}${NC}\n"
printf "  监听端口:   ${YELLOW}${APP_PORT}${NC}\n"
printf "  音乐路径:   ${YELLOW}${MUSIC_PATH}${NC}\n"
printf "  管理员:     ${YELLOW}${ADMIN_USER}${NC} / ${YELLOW}${ADMIN_PASS}${NC}\n"
[ -n "$DOMAIN" ] && printf "  域名:       ${YELLOW}${DOMAIN}${NC}\n"
printf "\n"

# ═══════════════════════════════════════════════════════════════
# Step 1: 系统依赖
# ═══════════════════════════════════════════════════════════════
log_title "1/6 安装系统依赖"
apt-get update -qq
apt-get install -y -qq python3 python3-pip python3-venv curl
if [ "$SKIP_NGINX" = false ]; then
  apt-get install -y -qq nginx
fi
log_info "✓ 系统依赖已安装"

# ═══════════════════════════════════════════════════════════════
# Step 2: 创建用户 & 部署文件
# ═══════════════════════════════════════════════════════════════
log_title "2/6 部署应用文件"

if ! id "$APP_USER" &>/dev/null; then
  useradd --system --shell /bin/bash --create-home --home-dir "/home/$APP_USER" "$APP_USER"
  log_info "✓ 用户 $APP_USER 已创建"
fi

mkdir -p "$INSTALL_DIR"
# 同步文件（保留已有的 data/ uploads/ log/）
rsync -a --exclude='data/' --exclude='uploads/' --exclude='log/' \
  --exclude='__pycache__/' --exclude='*.pyc' --exclude='.git/' \
  --exclude='dist/' --exclude='.run.*' --exclude='install.sh' \
  "$SCRIPT_DIR/" "$INSTALL_DIR/"

mkdir -p "$INSTALL_DIR/data" "$INSTALL_DIR/uploads/backgrounds" "$INSTALL_DIR/log"
log_info "✓ 文件已部署到 $INSTALL_DIR"

# ═══════════════════════════════════════════════════════════════
# Step 3: Python 环境 & 依赖
# ═══════════════════════════════════════════════════════════════
log_title "3/6 安装 Python 依赖"

if [ ! -d "$INSTALL_DIR/venv" ]; then
  python3 -m venv "$INSTALL_DIR/venv"
fi
"$INSTALL_DIR/venv/bin/pip" install --quiet --upgrade pip
"$INSTALL_DIR/venv/bin/pip" install --quiet -r "$INSTALL_DIR/requirements.txt"
log_info "✓ Python 依赖已安装"

# ═══════════════════════════════════════════════════════════════
# Step 4: 生成配置文件 & 初始化数据库
# ═══════════════════════════════════════════════════════════════
log_title "4/6 配置 & 数据库"

# 生成 env.pro（如果不存在或是模板则覆盖）
ENV_FILE="$INSTALL_DIR/env.pro"
if [ ! -f "$ENV_FILE" ] || grep -q 'CHANGE_ME' "$ENV_FILE" 2>/dev/null; then
  cat > "$ENV_FILE" << ENVEOF
# NEUROMIX // GRID — 生产环境配置
# 由 install.sh 自动生成于 $(date)

APP_ENV=production
APP_DEBUG=false
APP_PORT=${APP_PORT}
LOG_LEVEL=INFO

# JWT 密钥（自动生成的强随机值）
JWT_SECRET=${JWT_SECRET}

# 数据库
DATABASE_PATH=${INSTALL_DIR}/data/music.db

# 音乐路径
SYSTEM_MUSIC_PATH=${MUSIC_PATH}
UPLOAD_PATH=${INSTALL_DIR}/uploads

# AI（OpenAI 兼容接口，用于歌曲自动分类）
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o-mini
AI_ENABLED=false

# Gunicorn workers
GUNICORN_WORKERS=${WORKERS}

# 超级管理员
ADMIN_USERNAME=${ADMIN_USER}
ADMIN_PASSWORD=${ADMIN_HASH}
ENVEOF
  chmod 640 "$ENV_FILE"
  log_info "✓ env.pro 已生成"
else
  log_warn "env.pro 已存在且非模板，保留不覆盖"
fi

# 设置权限
chown -R "$APP_USER:$APP_USER" "$INSTALL_DIR"
chmod 750 "$INSTALL_DIR"

# 初始化数据库
cd "$INSTALL_DIR"
set -a; source "$ENV_FILE"; set +a
APP_ENV=production "$INSTALL_DIR/venv/bin/python" -c \
  "from app.database import init_db; init_db()" && log_info "✓ 数据库已初始化"

# ═══════════════════════════════════════════════════════════════
# Step 5: 导入音乐库
# ═══════════════════════════════════════════════════════════════
if [ "$SKIP_IMPORT" = false ] && [ -d "$MUSIC_PATH" ]; then
  log_title "5/6 导入音乐库"
  SONG_COUNT=$(find "$MUSIC_PATH" -type f \( -name '*.mp3' -o -name '*.m4a' -o -name '*.flac' -o -name '*.ogg' -o -name '*.wav' \) 2>/dev/null | wc -l)
  log_info "发现 $SONG_COUNT 个音频文件: $MUSIC_PATH"

  if [ "$SONG_COUNT" -gt 0 ]; then
    # 以 APP_USER 身份运行导入
    sudo -u "$APP_USER" bash -c "
      cd '$INSTALL_DIR'
      set -a; source '$ENV_FILE'; set +a
      APP_ENV=production '$INSTALL_DIR/venv/bin/python' scripts/import_music.py --music-path '$MUSIC_PATH'
    "
    log_info "✓ 音乐库导入完成"

    # 回填哈希
    log_info "回填文件哈希..."
    sudo -u "$APP_USER" bash -c "
      cd '$INSTALL_DIR'
      set -a; source '$ENV_FILE'; set +a
      APP_ENV=production '$INSTALL_DIR/venv/bin/python' scripts/backfill_hashes.py
    "
    log_info "✓ 文件哈希回填完成"
  else
    log_warn "目录为空或无音频文件，跳过导入"
  fi
else
  log_title "5/6 跳过音乐导入"
  [ "$SKIP_IMPORT" = true ] && log_info "用户指定跳过" || log_warn "音乐目录不存在: $MUSIC_PATH"
fi

# ═══════════════════════════════════════════════════════════════
# Step 6: systemd 服务 & Nginx
# ═══════════════════════════════════════════════════════════════
log_title "6/6 配置服务"

# systemd
cat > /etc/systemd/system/neuromix.service << SVCEOF
[Unit]
Description=NEUROMIX // GRID - Music Sharing Platform
After=network.target

[Service]
Type=exec
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${INSTALL_DIR}
EnvironmentFile=${INSTALL_DIR}/env.pro
ExecStart=${INSTALL_DIR}/venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers \${GUNICORN_WORKERS:-${WORKERS}} \
    --bind 127.0.0.1:${APP_PORT} \
    --timeout 120 \
    --keepalive 5 \
    --access-logfile ${INSTALL_DIR}/log/access.log \
    --error-logfile ${INSTALL_DIR}/log/error.log \
    --log-level info
ExecReload=/bin/kill -s HUP \$MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=append:${INSTALL_DIR}/log/stdout.log
StandardError=append:${INSTALL_DIR}/log/stderr.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=${INSTALL_DIR}/data ${INSTALL_DIR}/uploads ${INSTALL_DIR}/log

[Install]
WantedBy=multi-user.target
SVCEOF

systemctl daemon-reload
systemctl enable neuromix.service
systemctl restart neuromix.service
log_info "✓ systemd 服务已启动"

# Nginx
if [ "$SKIP_NGINX" = false ]; then
  NGINX_SERVER="${DOMAIN:-_}"
  cat > /etc/nginx/sites-available/neuromix << NGXEOF
upstream neuromix_backend {
    server 127.0.0.1:${APP_PORT};
    keepalive 32;
}
server {
    listen 80;
    server_name ${NGINX_SERVER};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;

    access_log /var/log/nginx/neuromix_access.log;
    error_log  /var/log/nginx/neuromix_error.log;

    client_max_body_size 55M;

    location /api/ {
        proxy_pass http://neuromix_backend;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 300;
        proxy_buffering off;
    }

    location /health {
        proxy_pass http://neuromix_backend;
        access_log off;
    }

    location / {
        proxy_pass http://neuromix_backend;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
NGXEOF

  ln -sf /etc/nginx/sites-available/neuromix /etc/nginx/sites-enabled/
  rm -f /etc/nginx/sites-enabled/default
  nginx -t && systemctl reload nginx
  log_info "✓ Nginx 已配置"
fi

# ═══════════════════════════════════════════════════════════════
# 健康检查
# ═══════════════════════════════════════════════════════════════
sleep 3
if curl -sf "http://localhost:${APP_PORT}/health" &>/dev/null; then
  log_info "✓ 服务健康检查通过"
else
  log_warn "服务可能未就绪，请检查: journalctl -u neuromix -n 30"
fi

# 统计
DB_SONGS=$("$INSTALL_DIR/venv/bin/python" -c "
import sqlite3; conn = sqlite3.connect('${INSTALL_DIR}/data/music.db')
print(conn.execute('SELECT COUNT(*) FROM songs').fetchone()[0])
conn.close()
" 2>/dev/null || echo "?")

DB_CATS=$("$INSTALL_DIR/venv/bin/python" -c "
import sqlite3; conn = sqlite3.connect('${INSTALL_DIR}/data/music.db')
print(conn.execute('SELECT COUNT(*) FROM categories').fetchone()[0])
conn.close()
" 2>/dev/null || echo "?")

# ═══════════════════════════════════════════════════════════════
# 完成
# ═══════════════════════════════════════════════════════════════
SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "localhost")

printf "\n${GREEN}${BOLD}╔══════════════════════════════════════════════════╗${NC}\n"
printf "${GREEN}${BOLD}║  NEUROMIX // GRID  安装完成！                    ║${NC}\n"
printf "${GREEN}${BOLD}╚══════════════════════════════════════════════════╝${NC}\n\n"

printf "  ${BOLD}访问地址:${NC}   "
[ -n "$DOMAIN" ] && printf "${CYAN}http://${DOMAIN}${NC}\n" || printf "${CYAN}http://${SERVER_IP}${NC}\n"
printf "  ${BOLD}管理员:${NC}     ${CYAN}${ADMIN_USER}${NC} / ${CYAN}${ADMIN_PASS}${NC}\n"
printf "  ${BOLD}歌曲总数:${NC}   ${CYAN}${DB_SONGS}${NC}\n"
printf "  ${BOLD}分类总数:${NC}   ${CYAN}${DB_CATS}${NC}\n"
printf "\n"
printf "  ${BOLD}常用命令:${NC}\n"
printf "    服务状态:  ${CYAN}systemctl status neuromix${NC}\n"
printf "    重启服务:  ${CYAN}systemctl restart neuromix${NC}\n"
printf "    查看日志:  ${CYAN}journalctl -u neuromix -f${NC}\n"
printf "    应用日志:  ${CYAN}tail -f ${INSTALL_DIR}/log/error.log${NC}\n"
printf "\n"
printf "  ${BOLD}配置文件:${NC}   ${YELLOW}${INSTALL_DIR}/env.pro${NC}\n"
printf "  ${BOLD}启用 AI:${NC}    编辑 env.pro 设置 AI_BASE_URL + AI_API_KEY + AI_ENABLED=true\n"
if [ -n "$DOMAIN" ]; then
  printf "  ${BOLD}启用 HTTPS:${NC} ${CYAN}apt install certbot python3-certbot-nginx && certbot --nginx -d ${DOMAIN}${NC}\n"
fi
printf "\n"
