#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# NEUROMIX // GRID - 项目运行管理脚本 v2.0.0
# 用法: ./run [命令] [-v] [-a] [-p 端口]
# 命令: setup|start|stop|restart|status|log|import|organize|
#       backfill|test|release
# 进程跟踪: .run.pid + .run.port（支持 PID + 端口双重清理）
# ═══════════════════════════════════════════════════════════════
set -e

VERSION="2.0.0"
AUTO_MODE=false
VERBOSE=false
PORT_OVERRIDE=""

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

APP_ENV="${APP_ENV:-local}"
PID_FILE=".run.pid"
PORT_FILE=".run.port"
LOG_DIR="log"
LOG_FILE="$LOG_DIR/app.log"
ERR_FILE="$LOG_DIR/err.log"
PORT="${APP_PORT:-2510}"

# 颜色
RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[1;33m')
BLUE=$(printf '\033[0;34m')
PURPLE=$(printf '\033[0;35m')
CYAN=$(printf '\033[0;36m')
BOLD=$(printf '\033[1m')
NC=$(printf '\033[0m')

#===============================================================================
# 共享工具函数
#===============================================================================

log_info()    { printf "%s[INFO]%s %s\n"  "$GREEN"  "$NC" "$1"; }
log_warn()    { printf "%s[WARN]%s %s\n"  "$YELLOW" "$NC" "$1"; }
log_error()   { printf "%s[ERROR]%s %s\n" "$RED"    "$NC" "$1" >&2; }
log_title()   { printf "\n%s%s=== %s ===%s\n\n" "$BLUE" "$BOLD" "$1" "$NC"; }
log_verbose() { [ "$VERBOSE" = true ] && printf "%s[VERBOSE]%s %s\n" "$PURPLE" "$NC" "$1"; return 0; }

format_cmd() {
    local rendered="" arg
    for arg in "$@"; do rendered="${rendered}$(printf '%q' "$arg") "; done
    printf '%s' "${rendered% }"
}
show_cmd() {
    [ "$VERBOSE" = true ] || return 0
    [ $# -le 1 ] && printf "%s[CMD]%s %s\n" "$CYAN" "$NC" "$1" \
                 || printf "%s[CMD]%s %s\n" "$CYAN" "$NC" "$(format_cmd "$@")"
}

read_with_default() {
    local prompt="$1" default="$2" result
    [ "$AUTO_MODE" = true ] && { echo "$default"; return; }
    [ ! -t 0 ] && { echo "$default"; return; }
    printf "%s%s%s [默认: %s%s%s]: " "$CYAN" "$prompt" "$NC" "$YELLOW" "$default" "$NC"
    read result
    echo "${result:-$default}"
}

confirm() {
    local prompt="$1" default="${2:-y}" result
    [ "$AUTO_MODE" = true ] && { [ "$default" = "y" ] && return 0 || return 1; }
    [ ! -t 0 ] && { [ "$default" = "y" ] && return 0 || return 1; }
    [ "$default" = "y" ] && printf "%s%s%s [%sY%s/n]: " "$CYAN" "$prompt" "$NC" "$YELLOW" "$NC" \
                         || printf "%s%s%s [y/%sN%s]: " "$CYAN" "$prompt" "$NC" "$YELLOW" "$NC"
    read -r result </dev/tty 2>/dev/null || result="$default"
    case "${result:-$default}" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

# ── Python 环境 ──────────────────────────────────────────────────
find_python() {
    local CONDA_PYTHON="$HOME/ins/miniconda/bin/python"
    if [ -f "$CONDA_PYTHON" ]; then
        echo "$CONDA_PYTHON"; return
    fi
    if command -v python3 &>/dev/null; then
        echo "python3"; return
    fi
    log_error "未找到 Python，请安装 Python 3.11+"; exit 1
}

PYTHON=$(find_python)
PIP="${PYTHON%python*}pip"
[ ! -f "${PIP}" ] && PIP="${PYTHON} -m pip"

# ── 进程 & 端口管理 ────────────────────────────────────────────
get_pid() {
    [ -f "$PID_FILE" ] || return 1
    local pid; pid=$(cat "$PID_FILE")
    ps -p "$pid" &>/dev/null && echo "$pid" && return 0
    return 1
}
is_running() { get_pid &>/dev/null; }

get_saved_port() {
    [ -f "$PORT_FILE" ] && cat "$PORT_FILE" 2>/dev/null || echo ""
}

# 杀死指定 PID（先 TERM 再 KILL）
_kill_pid() {
    local pid="$1"
    [ -z "$pid" ] && return 0
    ps -p "$pid" &>/dev/null || return 0
    kill "$pid" 2>/dev/null || true
    local i=0
    while [ $i -lt 10 ] && ps -p "$pid" &>/dev/null; do
        sleep 0.5; i=$((i+1))
    done
    if ps -p "$pid" &>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
        sleep 1
    fi
}

# 杀死端口上的所有 LISTEN 进程
_kill_port() {
    local port="$1"
    [ -z "$port" ] && return 0
    local pids
    pids=$(lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null) || true
    [ -z "$pids" ] && return 0
    log_verbose "清理端口 $port 上的进程: $pids"
    echo "$pids" | xargs kill -9 2>/dev/null || true
    sleep 1
}

# 检查端口是否被占用
assert_port_free() {
    local port="$1"
    [ -z "$port" ] && return 0
    if lsof -ti tcp:"$port" -sTCP:LISTEN &>/dev/null; then
        log_error "端口 $port 已被占用:"
        lsof -ti tcp:"$port" -sTCP:LISTEN | while read -r p; do
            ps -p "$p" -o pid=,ppid=,command= 2>/dev/null | sed 's/^/  /'
        done
        printf "\n提示: 用 %skill -9 <pid>%s 终止占用进程\n" "$YELLOW" "$NC"
        exit 1
    fi
}

# 获取进程正在监听的端口
_get_listen_ports() {
    local pid="$1" ports=""
    if [[ "$(uname)" == "Darwin" ]]; then
        ports=$(lsof -nP -p "$pid" -iTCP -sTCP:LISTEN 2>/dev/null \
            | awk 'NR>1{n=$9; sub(/.*:/,"",n); print n}' \
            | sort -un | tr '\n' ' ' | sed 's/ $//')
    else
        ports=$(ss -tlnp 2>/dev/null | grep "pid=$pid," \
            | awk '{n=$4; sub(/.*:/,"",n); print n}' \
            | sort -un | tr '\n' ' ' | sed 's/ $//')
        [ -z "$ports" ] && ports=$(lsof -nP -p "$pid" -iTCP -sTCP:LISTEN 2>/dev/null \
            | awk 'NR>1{n=$9; sub(/.*:/,"",n); print n}' \
            | sort -un | tr '\n' ' ' | sed 's/ $//')
    fi
    echo "$ports"
}

# ── 加载环境配置 ─────────────────────────────────────────────────
load_env() {
    local env_file
    if [ "$APP_ENV" = "production" ]; then
        env_file="env.pro"
    else
        env_file="env.loc"
    fi
    if [ -f "$env_file" ]; then
        log_info "加载配置文件: $env_file"
        set -a
        # shellcheck disable=SC1090
        source "$env_file"
        set +a
    else
        log_warn "配置文件不存在: $env_file（使用默认值）"
    fi
}

# ── 安装依赖 ────────────────────────────────────────────────────
cmd_setup() {
    log_title "安装依赖"
    mkdir -p "$LOG_DIR" data uploads

    if [ ! -f "requirements.txt" ]; then
        log_error "requirements.txt 不存在"; exit 1
    fi

    log_info "安装 Python 包..."
    show_cmd "$PYTHON" -m pip install -r requirements.txt -q
    $PYTHON -m pip install -r requirements.txt -q
    log_info "✓ 依赖安装完成"

    log_info "初始化数据库..."
    load_env
    show_cmd "$PYTHON" -c "from app.database import init_db; init_db()"
    $PYTHON -c "from app.database import init_db; init_db()"
    log_info "✓ 数据库初始化完成"
}

# ── 导入音乐库 ──────────────────────────────────────────────────
cmd_import() {
    log_title "导入音乐库"
    load_env
    local music_path="${1:-${SYSTEM_MUSIC_PATH:-/var/www/html/downloads/mp3}}"
    log_info "音乐路径: $music_path"
    show_cmd "$PYTHON" scripts/import_music.py --music-path "$music_path"
    $PYTHON scripts/import_music.py --music-path "$music_path" "${@:2}"
}

# ── 启动服务 ────────────────────────────────────────────────────
cmd_start() {
    if is_running; then
        local pid; pid=$(get_pid)
        log_warn "服务已在运行 (PID: $pid)"
        return 0
    fi

    log_title "启动 NEUROMIX // GRID"
    load_env
    mkdir -p "$LOG_DIR" data uploads

    # -p 临时覆盖端口（不写入配置）
    local _port="${PORT_OVERRIDE:-$PORT}"
    assert_port_free "$_port"

    if [ "$APP_ENV" = "production" ]; then
        WORKERS=${GUNICORN_WORKERS:-4}
        log_info "生产模式: Gunicorn, workers=$WORKERS, port=$_port"
        show_cmd nohup "$PYTHON" -m gunicorn app.main:app \
            --worker-class uvicorn.workers.UvicornWorker \
            --workers "$WORKERS" \
            --bind "0.0.0.0:$_port" \
            --timeout 120 \
            --access-logfile "$LOG_FILE" \
            --error-logfile "$ERR_FILE" \
            --log-level "$(echo "${LOG_LEVEL:-info}" | tr '[:upper:]' '[:lower:]')"
        nohup $PYTHON -m gunicorn app.main:app \
            --worker-class uvicorn.workers.UvicornWorker \
            --workers "$WORKERS" \
            --bind "0.0.0.0:$_port" \
            --timeout 120 \
            --access-logfile "$LOG_FILE" \
            --error-logfile "$ERR_FILE" \
            --log-level "$(echo "${LOG_LEVEL:-info}" | tr '[:upper:]' '[:lower:]')" \
            >> "$LOG_FILE" 2>> "$ERR_FILE" &
    else
        log_info "开发模式: Uvicorn reload, port=$_port"
        show_cmd nohup "$PYTHON" -m uvicorn app.main:app \
            --host 0.0.0.0 \
            --port "$_port" \
            --reload \
            --log-level "$(echo "${LOG_LEVEL:-debug}" | tr '[:upper:]' '[:lower:]')"
        nohup $PYTHON -m uvicorn app.main:app \
            --host 0.0.0.0 \
            --port "$_port" \
            --reload \
            --log-level "$(echo "${LOG_LEVEL:-debug}" | tr '[:upper:]' '[:lower:]')" \
            >> "$LOG_FILE" 2>> "$ERR_FILE" &
    fi

    echo $! > "$PID_FILE"
    echo "$_port" > "$PORT_FILE"
    local pid; pid=$(cat "$PID_FILE")

    # 等待服务就绪（最多15秒）
    local i=0
    while [ $i -lt 15 ]; do
        sleep 1
        if curl -sf "http://localhost:$_port/health" &>/dev/null; then
            log_info "✓ 服务启动成功 (PID: $pid)"
            printf "\n  主页: ${CYAN}http://localhost:$_port/${NC}\n"
            printf "  API:  ${CYAN}http://localhost:$_port/docs${NC}\n\n"
            return 0
        fi
        i=$((i+1))
        printf "."
    done
    printf "\n"
    log_warn "服务可能未完全就绪，请查看日志: $LOG_FILE"
}

# ── 停止服务 ────────────────────────────────────────────────────
cmd_stop() {
    local _saved_port; _saved_port=$(get_saved_port)
    local _cfg_port="${PORT_OVERRIDE:-$PORT}"
    local _stopped=false

    # 1. 通过 .run.pid 优雅停止
    if get_pid &>/dev/null; then
        local _pid; _pid=$(get_pid)
        log_info "停止服务 (PID: $_pid)..."
        _kill_pid "$_pid"
        _stopped=true
    fi

    # 2. 通过 .run.port 清理（处理 PID 文件丢失或子进程残留）
    if [ -n "$_saved_port" ]; then
        _kill_port "$_saved_port"
    fi

    # 3. 兜底：检查配置端口（处理手动 nohup 启动的情况）
    if [ "$_saved_port" != "$_cfg_port" ]; then
        _kill_port "$_cfg_port"
    fi

    rm -f "$PID_FILE" "$PORT_FILE"
    [ "$_stopped" = true ] && log_info "✓ 服务已停止" || log_warn "服务未运行"
}

# ── 重启 ─────────────────────────────────────────────────────────
cmd_restart() {
    # stop 不中断 restart：即使 stop 出错也继续 start
    cmd_stop || true
    sleep 1
    cmd_start
}

# ── 状态 ─────────────────────────────────────────────────────────
cmd_status() {
    printf "\n%s%sNEUROMIX // GRID 状态%s\n" "$BOLD" "$CYAN" "$NC"
    printf "目录:   %s%s%s\n" "$YELLOW" "$SCRIPT_DIR" "$NC"
    printf "环境:   %s%s%s\n" "$YELLOW" "$APP_ENV" "$NC"
    printf "日志:   %s%s%s\n" "$YELLOW" "$LOG_FILE" "$NC"
    printf "错误:   %s%s%s\n\n" "$YELLOW" "$ERR_FILE" "$NC"
    if is_running; then
        local pid; pid=$(get_pid)
        printf "%s● 运行中%s\n" "$GREEN" "$NC"
        printf "  %sPID:%s      %s\n" "$BOLD" "$NC" "$pid"
        local start_time
        if [[ "$(uname)" == "Darwin" ]]; then
            start_time=$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//')
        else
            start_time=$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//')
            [ -z "$start_time" ] && start_time=$(ps -p "$pid" -o start= 2>/dev/null | sed 's/^ *//')
        fi
        [ -n "$start_time" ] && printf "  %s启动时间:%s %s\n" "$BOLD" "$NC" "$start_time"
        local cpu_mem; cpu_mem=$(ps -p "$pid" -o %cpu=,%mem= 2>/dev/null | sed 's/^ *//')
        [ -n "$cpu_mem" ] && printf "  %sCPU/MEM:%s  %s%%\n" "$BOLD" "$NC" "$cpu_mem"
        local ports; ports=$(_get_listen_ports "$pid")
        [ -n "$ports" ] \
            && printf "  %s端口:%s     %s%s%s\n" "$BOLD" "$NC" "$YELLOW" "$ports" "$NC" \
            || printf "  %s端口:%s     (未检测到监听端口)\n" "$BOLD" "$NC"
        if curl -sf "http://localhost:${PORT_OVERRIDE:-$PORT}/health" &>/dev/null; then
            printf "  %s健康:%s     %sOK%s\n" "$BOLD" "$NC" "$GREEN" "$NC"
        fi
    else
        printf "%s○ 未运行%s\n" "$RED" "$NC"
        local dead_pid=""
        [ -f "$PID_FILE" ] && dead_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -n "$dead_pid" ] && printf "  %s上次 PID: %s（进程已终止）%s\n" "$YELLOW" "$dead_pid" "$NC"
    fi
    local sn; sn=$(basename "$0")
    printf "\n%s操作命令:%s\n" "$BOLD" "$NC"
    printf "  启动:  %s%s start%s\n"   "$CYAN" "$sn" "$NC"
    printf "  重启:  %s%s restart%s\n" "$CYAN" "$sn" "$NC"
    printf "  停止:  %s%s stop%s\n"    "$CYAN" "$sn" "$NC"
    printf "  日志:  %s%s log%s\n"     "$CYAN" "$sn" "$NC"
    printf "  状态:  %s%s status%s\n\n" "$CYAN" "$sn" "$NC"
}

# ── 日志 ─────────────────────────────────────────────────────────
cmd_log() {
    if [ "${1:-}" = "err" ]; then
        [ -f "$ERR_FILE" ] || { log_warn "错误日志不存在: $ERR_FILE"; exit 1; }
        printf "错误: %s%s%s (Ctrl+C 退出)\n\n" "$YELLOW" "$ERR_FILE" "$NC"
        show_cmd tail -f "$ERR_FILE"
        tail -f "$ERR_FILE"
    else
        [ -f "$LOG_FILE" ] || { log_warn "日志不存在: $LOG_FILE"; exit 1; }
        printf "日志: %s%s%s (Ctrl+C 退出)\n\n" "$YELLOW" "$LOG_FILE" "$NC"
        show_cmd tail -f "$LOG_FILE"
        tail -f "$LOG_FILE"
    fi
}

# ── 回填文件哈希 ─────────────────────────────────────────────────
cmd_backfill() {
    log_title "回填文件哈希（去重数据补全）"
    load_env
    local dry="${1:-}"
    if [ "$dry" = "--dry-run" ]; then
        log_info "【预演模式】只显示计划，不写库"
        show_cmd "$PYTHON" scripts/backfill_hashes.py --dry-run
        $PYTHON scripts/backfill_hashes.py --dry-run
    else
        show_cmd "$PYTHON" scripts/backfill_hashes.py
        $PYTHON scripts/backfill_hashes.py
    fi
}

# ── 整理音乐文件 ─────────────────────────────────────────────────
cmd_organize() {
    log_title "整理音乐文件"
    load_env
    local music_path="${1:-${SYSTEM_MUSIC_PATH:-/var/www/html/downloads/mp3}}"
    local dry_run="${2:-}"
    log_info "音乐路径: $music_path"
    if [ "$dry_run" = "--dry-run" ]; then
        log_info "【预演模式】只显示计划，不实际移动文件"
        show_cmd "$PYTHON" scripts/organize_music.py --music-path "$music_path" --dry-run
        $PYTHON scripts/organize_music.py --music-path "$music_path" --dry-run
    else
        show_cmd "$PYTHON" scripts/organize_music.py --music-path "$music_path"
        $PYTHON scripts/organize_music.py --music-path "$music_path"
    fi
}

# ── 测试 ─────────────────────────────────────────────────────────
cmd_test() {
    log_title "自动化测试"
    local _port="${PORT_OVERRIDE:-$PORT}"
    local _base="http://localhost:$_port"

    # 检查服务是否在跑
    if ! curl -sf "$_base/health" &>/dev/null; then
        log_warn "服务未运行，先启动..."
        cmd_start
    fi

    show_cmd bash scripts/test.sh "$_base"
    bash scripts/test.sh "$_base"
}

# ── 发布打包 ─────────────────────────────────────────────────────
cmd_release() {
    log_title "发布打包"
    show_cmd bash scripts/release.sh "${CMD_ARGS[0]:-}"
    bash scripts/release.sh "${CMD_ARGS[0]:-}"
}

# ── 帮助 ─────────────────────────────────────────────────────────
cmd_help() {
    local sn; sn=$(basename "$0")
    printf "\n%s%sNEUROMIX // GRID 管理脚本%s  v%s\n\n" "$BOLD" "$CYAN" "$NC" "$VERSION"
    printf "用法: %s%s%s [命令] [%s-v%s] [%s-a%s] [%s-p 端口%s]\n\n" \
        "$CYAN" "$sn" "$NC" "$YELLOW" "$NC" "$YELLOW" "$NC" "$YELLOW" "$NC"
    printf "%s命令:%s\n" "$BOLD" "$NC"
    printf "  %ssetup%s                     安装依赖、初始化数据库\n" "$GREEN" "$NC"
    printf "  %sstart%s                     启动服务\n" "$GREEN" "$NC"
    printf "  %sstop%s                      停止服务\n" "$GREEN" "$NC"
    printf "  %srestart%s                   重启服务\n" "$GREEN" "$NC"
    printf "  %sstatus%s                    查看状态\n" "$GREEN" "$NC"
    printf "  %slog%s                       查看运行日志 (tail -f)\n" "$GREEN" "$NC"
    printf "  %slog err%s                   查看错误日志\n" "$GREEN" "$NC"
    printf "  %simport [path]%s             导入音乐库（默认读取 config 路径）\n" "$GREEN" "$NC"
    printf "  %simport-ai [path]%s          导入 + AI 分类\n" "$GREEN" "$NC"
    printf "  %sorganize [path]%s           按分类整理音乐文件（移动）\n" "$GREEN" "$NC"
    printf "  %sorganize [path] --dry-run%s 预演整理，不实际移动\n" "$GREEN" "$NC"
    printf "  %sbackfill%s                  为存量歌曲回填 SHA-256 哈希（部署后首次运行）\n" "$GREEN" "$NC"
    printf "  %sbackfill --dry-run%s        预演回填\n" "$GREEN" "$NC"
    printf "  %stest%s                      运行自动化测试（24+ 项断言）\n" "$GREEN" "$NC"
    printf "  %srelease [version]%s         发布打包（生成 dist/neuromix-*.tar.gz）\n\n" "$GREEN" "$NC"
    printf "%s全局选项:%s\n" "$BOLD" "$NC"
    printf "  %s-p <port>%s, %s--port <port>%s  临时指定端口（不写入配置，覆盖 APP_PORT）\n" \
        "$YELLOW" "$NC" "$YELLOW" "$NC"
    printf "  %s-v%s, %s--verbose%s             展示详细步骤与执行命令\n" \
        "$YELLOW" "$NC" "$YELLOW" "$NC"
    printf "  %s-a%s, %s--auto%s                自动模式（非交互，使用默认值）\n" \
        "$YELLOW" "$NC" "$YELLOW" "$NC"
    printf "\n%s环境变量:%s\n" "$BOLD" "$NC"
    printf "  APP_ENV=local|production  运行环境（默认 local）\n"
    printf "  APP_PORT=2510             监听端口\n\n"
    printf "%s快速开始:%s\n" "$BOLD" "$NC"
    printf "  %s%s setup%s           # 初始化\n" "$CYAN" "$sn" "$NC"
    printf "  %s%s import%s          # 导入音乐库\n" "$CYAN" "$sn" "$NC"
    printf "  %s%s start%s           # 启动服务\n" "$CYAN" "$sn" "$NC"
    printf "  %s%s start -p 3000%s   # 指定端口启动\n\n" "$CYAN" "$sn" "$NC"
}

#===============================================================================
# 全局参数解析 & 主命令分发
#===============================================================================

COMMAND=""
CMD_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true; shift ;;
        -a|--auto)
            AUTO_MODE=true; shift ;;
        -p|--port)
            shift
            if [ $# -gt 0 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
                PORT_OVERRIDE="$1"; shift
            else
                log_warn "-p/--port 需要端口号"
            fi
            ;;
        -h|--help)
            COMMAND="help"; shift ;;
        -*)
            log_warn "未知选项: $1"; shift ;;
        *)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"; shift
            else
                CMD_ARGS+=("$1"); shift
            fi
            ;;
    esac
done

log_verbose "命令=${COMMAND:-help} 参数=[${CMD_ARGS[*]:-}] AUTO=$AUTO_MODE 端口覆盖=${PORT_OVERRIDE:-无}"

case "${COMMAND:-help}" in
    setup)           cmd_setup ;;
    start)           cmd_start ;;
    stop)            cmd_stop ;;
    restart)         cmd_restart ;;
    status)          cmd_status ;;
    log)             cmd_log "${CMD_ARGS[0]:-}" ;;
    import)          cmd_import "${CMD_ARGS[0]:-}" ;;
    import-ai)       cmd_import "${CMD_ARGS[0]:-}" --ai ;;
    organize)        cmd_organize "${CMD_ARGS[0]:-}" "${CMD_ARGS[1]:-}" ;;
    backfill)        cmd_backfill "${CMD_ARGS[0]:-}" ;;
    test)            cmd_test ;;
    release)         cmd_release ;;
    help|--help|-h)  cmd_help ;;
    *)
        log_error "未知命令: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
